node_modules
dist
dist-standalone
flipza.html
_shots

# Generated by scripts/prepare-*.mjs from the sources below.
public/sprites
public/fire
public/toppings
public/props
public/plate.webp
public/logo.webp

# Sources are stored as lossless WebP - same pixels, 40% of the bytes. The PNGs
# the generators wrote are kept on disk but not in the repository; run
# `npm run to-webp` after a generation batch to convert new ones.
*.png

# Intermediates, rebuilt in seconds by prepare-oven and prepare-portrait.
oven-src/plate-flameless.webp
portrait-src/plate-tall.webp
portrait-src/_input.webp

# Inputs built for a single generation, and superseded takes.
**/_*.webp
**/pass1/
*-take*.webp
props-src/box-open-take1-orig.webp

# The kitchen was rendered from these twelve frames long before the scene was a
# canvas; nothing has read them since. Kept on disk, out of the repository.
frames-src/

# Screenshots in the README are committed; other PNGs are not.
!docs/*.png

# Deploy worktrees (now built in the temp directory, but older runs left these).
.deploy*
